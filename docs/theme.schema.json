{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GameCloudSave theme v1",
  "type": "object",
  "required": ["schemaVersion", "name", "colors"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {"const": 1},
    "name": {"type": "string", "maxLength": 40},
    "dark": {"type": "boolean", "default": true},
    "colors": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "background": {"$ref": "#/$defs/color"},
        "sidebar": {"$ref": "#/$defs/color"},
        "surface": {"$ref": "#/$defs/color"},
        "hover": {"$ref": "#/$defs/color"},
        "border": {"$ref": "#/$defs/color"},
        "text": {"$ref": "#/$defs/color"},
        "secondary": {"$ref": "#/$defs/color"},
        "accent": {"$ref": "#/$defs/color"}
      }
    }
  },
  "$defs": {"color": {"type": "string", "pattern": "^#[0-9a-fA-F]{6}$"}}
}
